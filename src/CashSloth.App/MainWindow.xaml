<Window x:Class="CashSloth.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CashSloth POS" Height="720" Width="1240"
        Icon="Assets/CashSlothLogo.png"
        Loaded="OnWindowLoaded"
        Closing="OnWindowClosing">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition x:Name="ToolbarRowDefinition" Height="66" />
      <RowDefinition x:Name="ShopContentRowDefinition" Height="*" />
      <RowDefinition x:Name="CheckoutControlsRowDefinition" Height="Auto" />
      <RowDefinition x:Name="SummaryRowDefinition" Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="660" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border x:Name="ToolbarBorder"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            BorderBrush="{DynamicResource AppControlBorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8"
            Margin="0,0,0,10"
            Background="{DynamicResource AppSurfaceBrush}">
      <TabControl x:Name="ToolbarTabControl"
                  BorderThickness="0"
                  Background="Transparent"
                  SelectionChanged="OnToolbarTabSelectionChanged">
        <TabItem x:Name="ShopTab" Header="Shop" />

        <TabItem x:Name="SettingsTab" Header="Settings">
          <WrapPanel VerticalAlignment="Center" Margin="0,4,0,0">
            <TextBlock Text="Language" FontSize="14" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
            <ComboBox x:Name="LanguageComboBox"
                      Style="{StaticResource TopBarComboBoxStyle}"
                      Width="190"
                      Height="34"
                      Margin="0,0,14,0"
                      VerticalContentAlignment="Center"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectionChanged="OnLanguageSelectionChanged" />

            <TextBlock Text="Currency" FontSize="14" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
            <ComboBox x:Name="CurrencyComboBox"
                      Style="{StaticResource TopBarComboBoxStyle}"
                      Width="130"
                      Height="34"
                      Margin="0,0,14,0"
                      VerticalContentAlignment="Center"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectionChanged="OnCurrencySelectionChanged" />

            <TextBlock Text="UI Color" FontSize="14" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
            <ComboBox x:Name="ThemeComboBox"
                      Style="{StaticResource TopBarComboBoxStyle}"
                      Width="140"
                      Height="34"
                      Margin="0,0,14,0"
                      VerticalContentAlignment="Center"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectionChanged="OnThemeSelectionChanged" />

            <Button Content="Show tutorial"
                    Width="130"
                    Height="34"
                    Click="OnShowOnboardingClick" />
          </WrapPanel>
        </TabItem>

        <TabItem x:Name="PresetsTab" Header="Presets">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        PanningMode="VerticalOnly">
          <Grid Margin="0,4,0,0"
                Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource AppControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8">
              <StackPanel>
                <TextBlock Text="Local presets" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ComboBox x:Name="LocalPresetComboBox"
                          Style="{StaticResource TopBarComboBoxStyle}"
                          Height="34"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value" />
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="Switch preset" Width="120" Height="34" Click="OnSwitchPresetClick" />
                  <Button Content="Refresh" Width="90" Height="34" Margin="6,0,0,0" Click="OnRefreshPresetListClick" />
                  <Button Content="Delete preset" Width="120" Height="34" Margin="6,0,0,0" Click="OnDeletePresetClick" />
                </WrapPanel>

                <TextBlock Text="Save current as" FontWeight="SemiBold" Margin="0,10,0,4" />
                <TextBox x:Name="NewPresetNameTextBox"
                         Height="34"
                         VerticalContentAlignment="Center"
                         ToolTip="Preset name (e.g. Summer Menu)" />
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="Save current preset" Width="170" Height="34" Click="OnSaveCurrentPresetClick" />
                  <CheckBox x:Name="SetSavedPresetActiveCheckBox"
                            Content="Set active"
                            Margin="12,8,0,0"
                            VerticalAlignment="Center"
                            IsChecked="True" />
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource AppControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8">
              <StackPanel>
                <TextBlock Text="Central presets" FontWeight="SemiBold" Margin="0,0,0,6" />

                <TextBlock Text="Central server URL" Margin="0,2,0,2" />
                <TextBox x:Name="CentralServerUrlTextBox"
                         Height="34"
                         IsReadOnly="True"
                         VerticalContentAlignment="Center"
                         ToolTip="Pinned central server URL" />

                <WrapPanel Margin="0,8,0,0">
                  <Button x:Name="RefreshCentralPresetListButton" Content="Load central presets" Width="170" Height="34" Click="OnRefreshCentralPresetListClick" />
                </WrapPanel>

                <TextBlock Text="Central preset list" Margin="0,8,0,2" />
                <ComboBox x:Name="CentralPresetComboBox"
                          Style="{StaticResource TopBarComboBoxStyle}"
                          Height="34"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value" />

                <TextBlock Text="Optional preset name" Margin="0,8,0,2" />
                <TextBox x:Name="CentralPresetNameTextBox"
                         Height="34"
                         VerticalContentAlignment="Center"
                         ToolTip="Override preset name" />

                <WrapPanel Margin="0,8,0,0">
                  <Button x:Name="ImportCentralPresetButton" Content="Import selected central preset" Width="210" Height="34" Click="OnImportCentralPresetClick" />
                  <Button x:Name="UploadPresetButton" Content="Upload active preset" Width="170" Height="34" Margin="6,0,0,0" Click="OnUploadPresetClick" />
                  <CheckBox x:Name="SetImportedPresetActiveCheckBox"
                            Content="Set active"
                            Margin="12,8,0,0"
                            VerticalAlignment="Center"
                            IsChecked="False" />
                </WrapPanel>

                <TextBlock Text="Presets are loaded through the authenticated central server session."
                           Margin="0,8,0,0"
                           FontSize="12"
                           Opacity="0.8" />
              </StackPanel>
            </Border>
          </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="AccountsTab" Header="Accounts">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        PanningMode="VerticalOnly">
          <Grid Margin="0,4,0,0"
                Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="2*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource AppControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8">
              <StackPanel>
                <Border BorderBrush="{DynamicResource AppControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="Central server trust &amp; device pairing" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Button Content="Import .cashsloth-trust…" Height="34" Click="OnImportServerTrustClick" />
                    <TextBlock x:Name="ServerFingerprintTextBlock" Text="No server trusted" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <TextBlock Text="Device name" Margin="0,8,0,2" />
                    <TextBox x:Name="DeviceNameTextBox" Height="34" VerticalContentAlignment="Center" />
                    <TextBlock Text="10-character pairing code" Margin="0,8,0,2" />
                    <TextBox x:Name="DevicePairingCodeTextBox" Height="34" MaxLength="14" VerticalContentAlignment="Center" />
                    <Button x:Name="PairDeviceButton" Content="Pair this device" Height="34" Margin="0,8,0,0" Click="OnPairDeviceClick" />
                    <TextBlock x:Name="ServerConnectionStatusTextBlock" Text="Offline / not configured" TextWrapping="Wrap" Margin="0,6,0,0" />
                  </StackPanel>
                </Border>

                <TextBlock Text="Session" FontWeight="SemiBold" Margin="0,0,0,6" />
                <TextBlock x:Name="CurrentUserTextBlock" Text="Not signed in" Margin="0,0,0,8" />

                <TextBlock Text="Username" Margin="0,2,0,2" />
                <TextBox x:Name="LoginUsernameTextBox"
                         Height="34"
                         VerticalContentAlignment="Center" />

                <TextBlock Text="Password" Margin="0,8,0,2" />
                <PasswordBox x:Name="LoginPasswordBox"
                             Height="34"
                             VerticalContentAlignment="Center" />

                <WrapPanel Margin="0,8,0,0">
                  <Button x:Name="LoginButton" Content="Login" Width="110" Height="34" Click="OnLoginClick" />
                  <Button x:Name="LogoutButton" Content="Logout" Width="110" Height="34" Margin="6,0,0,0" Click="OnLogoutClick" />
                </WrapPanel>
                <TextBlock Text="Change password (current / new)" Margin="0,10,0,2" />
                <WrapPanel>
                  <PasswordBox x:Name="CurrentPasswordChangeBox" Width="150" Height="34" />
                  <PasswordBox x:Name="NewPasswordChangeBox" Width="150" Height="34" Margin="6,0,0,0" />
                  <Button x:Name="ChangePasswordButton" Content="Change" Width="90" Height="34" Margin="6,0,0,0" Click="OnChangePasswordClick" />
                </WrapPanel>
                <Border BorderBrush="{DynamicResource AppControlBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8"
                        Margin="0,18,0,0">
                  <StackPanel>
                    <TextBlock Text="Create account" FontWeight="SemiBold" Margin="0,0,0,6" />

                    <TextBlock Text="Username" Margin="0,2,0,2" />
                    <TextBox x:Name="SelfRegisterUsernameTextBox"
                             Height="34"
                             VerticalContentAlignment="Center" />

                    <TextBlock Text="Password" Margin="0,8,0,2" />
                    <PasswordBox x:Name="SelfRegisterPasswordBox"
                                 Height="34"
                                 VerticalContentAlignment="Center" />

                    <TextBlock Text="Confirm password" Margin="0,8,0,2" />
                    <PasswordBox x:Name="SelfRegisterConfirmPasswordBox"
                                 Height="34"
                                 VerticalContentAlignment="Center" />

                    <Button x:Name="CreateAccountButton"
                            Content="Create normal user"
                            Width="170"
                            Height="34"
                            Margin="0,10,0,0"
                            Click="OnCreateAccountClick" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    BorderBrush="{DynamicResource AppControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="8">
              <StackPanel>
                <TextBlock Text="Account management (Admin)" FontWeight="SemiBold" Margin="0,0,0,6" />
                <ListBox x:Name="AccountsListBox"
                         Height="130"
                         DisplayMemberPath="Username"
                         SelectionChanged="OnAccountSelectionChanged" />
                <Button x:Name="RefreshAccountsButton"
                        Content="Refresh accounts"
                        Width="140"
                        Height="34"
                        Margin="0,8,0,0"
                        Click="OnRefreshAccountsClick" />

                <TextBlock Text="Username" Margin="0,10,0,2" />
                <TextBox x:Name="AccountUsernameTextBox"
                         Height="34"
                         VerticalContentAlignment="Center" />

                <TextBlock Text="Role" Margin="0,8,0,2" />
                <ComboBox x:Name="AccountRoleComboBox"
                          Style="{StaticResource TopBarComboBoxStyle}"
                          Height="34"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value" />

                <CheckBox x:Name="AccountEnabledCheckBox"
                          Content="Enabled"
                          Margin="0,8,0,0"
                          IsChecked="True" />
                <CheckBox x:Name="AccountApprovedCheckBox"
                          Content="Approved"
                          Margin="0,8,0,0"
                          IsChecked="False" />

                <WrapPanel Margin="0,8,0,0">
                  <Button x:Name="SaveAccountButton" Content="Save account" Width="130" Height="34" Click="OnSaveAccountClick" />
                  <Button x:Name="DeleteAccountButton" Content="Reset password" Width="130" Height="34" Margin="6,0,0,0" Click="OnDeleteAccountClick" />
                </WrapPanel>
              </StackPanel>
            </Border>
          </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="EventTab" Header="Event">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        PanningMode="VerticalOnly">
            <Grid Margin="0,4,0,0"
                  Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="3*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0"
                      Grid.Row="0"
                      BorderBrush="{DynamicResource AppControlBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="8">
                <StackPanel>
                  <TextBlock Text="Event context" FontWeight="SemiBold" Margin="0,0,0,6" />

                  <TextBlock Text="Event name" Margin="0,2,0,2" />
                  <TextBox x:Name="EventNameTextBox"
                           Height="34"
                           VerticalContentAlignment="Center"
                           ToolTip="Event name for history and statistics" />

                  <TextBlock Text="Register" Margin="0,8,0,2" />
                  <TextBox x:Name="RegisterNameTextBox"
                           Height="34"
                           VerticalContentAlignment="Center"
                           ToolTip="Register/till name (e.g. Kasse 1)" />

                  <CheckBox x:Name="ShowcaseModeCheckBox"
                            Content="Showcase mode (exclude from statistics)"
                            Margin="0,10,0,0" />
                </StackPanel>
              </Border>

              <Border Grid.Column="2"
                      Grid.Row="0"
                      BorderBrush="{DynamicResource AppControlBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="8">
                <StackPanel>
                  <TextBlock Text="Checkout" FontWeight="SemiBold" Margin="0,0,0,6" />

                  <TextBlock Text="Payment method" Margin="0,2,0,2" />
                  <ComboBox x:Name="PaymentMethodComboBox"
                            Style="{StaticResource TopBarComboBoxStyle}"
                            Height="34"
                            DisplayMemberPath="Label"
                            SelectedValuePath="Value" />

                  <TextBlock Text="Tip amount" Margin="0,8,0,2" />
                  <TextBox x:Name="TipAmountTextBox"
                           Height="34"
                           VerticalContentAlignment="Center"
                           ToolTip="Optional tip amount"
                           TextChanged="OnTipAmountChanged" />

                  <TextBlock x:Name="SaleContextStatusText"
                             Text="Cart total: CHF 0.00"
                             Margin="0,8,0,0"
                             FontSize="13"
                             FontWeight="SemiBold" />

                  <Button x:Name="CompleteSaleButton"
                          Content="Complete sale"
                          Width="150"
                          Height="36"
                          Margin="0,10,0,0"
                          Click="OnCompleteSaleClick" />
                </StackPanel>
              </Border>

              <Border Grid.Row="2"
                      Grid.Column="0"
                      BorderBrush="{DynamicResource AppControlBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="8">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Text="Host: add client register" FontWeight="SemiBold" Margin="0,0,0,6" />
                  <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                    <Button x:Name="ScanClientRegistersButton"
                            Content="Add additional register"
                            Width="180"
                            Height="34"
                            Click="OnScanClientRegistersClick" />
                    <Button x:Name="AddSelectedClientRegisterButton"
                            Content="Add selected client"
                            Width="160"
                            Height="34"
                            Margin="6,0,0,0"
                            Click="OnAddSelectedClientRegisterClick" />
                  </WrapPanel>

                  <TextBlock Grid.Row="2" Text="Visible registers" Margin="0,0,0,4" />
                  <ListBox x:Name="DiscoveredRegistersListBox"
                           Grid.Row="3"
                           Height="120"
                           FontSize="13"
                           ScrollViewer.PanningMode="VerticalOnly" />
                </Grid>
              </Border>

              <Border Grid.Row="2"
                      Grid.Column="2"
                      BorderBrush="{DynamicResource AppControlBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="8">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <TextBlock Grid.Row="0" Text="Network client mode" FontWeight="SemiBold" Margin="0,0,0,6" />
                  <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                    <Button x:Name="ToggleRegisterAdvertisementButton"
                            Content="Show this register on network"
                            Width="230"
                            Height="34"
                            Click="OnToggleRegisterAdvertisementClick" />
                    <Button x:Name="RefreshClientRegistersButton"
                            Content="Refresh clients"
                            Width="130"
                            Height="34"
                            Margin="6,0,0,0"
                            Click="OnRefreshClientRegistersClick" />
                    <Button x:Name="RemoveSelectedClientRegisterButton"
                            Content="Remove selected"
                            Width="140"
                            Height="34"
                            Margin="6,0,0,0"
                            Click="OnRemoveSelectedClientRegisterClick" />
                  </WrapPanel>

                  <TextBlock x:Name="EventNetworkStatusText"
                             Grid.Row="2"
                             Text="Network mode idle."
                             Margin="0,0,0,4"
                             FontSize="13"
                             FontWeight="SemiBold" />
                  <ListBox x:Name="EventClientRegistersListBox"
                           Grid.Row="3"
                           Height="120"
                           FontSize="13"
                           SelectionChanged="OnEventClientRegisterSelectionChanged"
                           ScrollViewer.PanningMode="VerticalOnly" />
                </Grid>
              </Border>

              <Border Grid.Row="4"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      BorderBrush="{DynamicResource AppControlBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <StackPanel Grid.Column="0">
                    <TextBlock Text="Event totals" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <UniformGrid Columns="2">
                      <TextBlock Text="Sales" FontWeight="SemiBold" />
                      <TextBlock x:Name="EventTotalSalesValueText" Text="0" />
                      <TextBlock Text="Subtotal" FontWeight="SemiBold" />
                      <TextBlock x:Name="EventTotalSubtotalValueText" Text="CHF 0.00" />
                      <TextBlock Text="Tips" FontWeight="SemiBold" />
                      <TextBlock x:Name="EventTotalTipValueText" Text="CHF 0.00" />
                      <TextBlock Text="Total" FontWeight="SemiBold" />
                      <TextBlock x:Name="EventTotalValueText" Text="CHF 0.00" />
                    </UniformGrid>
                  </StackPanel>

                  <StackPanel Grid.Column="2">
                    <TextBlock x:Name="EventRegisterStatsTitleText"
                               Text="Selected register"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6" />
                    <UniformGrid Columns="2">
                      <TextBlock Text="Sales" FontWeight="SemiBold" />
                      <TextBlock x:Name="EventRegisterSalesValueText" Text="0" />
                      <TextBlock Text="Subtotal" FontWeight="SemiBold" />
                      <TextBlock x:Name="EventRegisterSubtotalValueText" Text="CHF 0.00" />
                      <TextBlock Text="Tips" FontWeight="SemiBold" />
                      <TextBlock x:Name="EventRegisterTipValueText" Text="CHF 0.00" />
                      <TextBlock Text="Total" FontWeight="SemiBold" />
                      <TextBlock x:Name="EventRegisterTotalValueText" Text="CHF 0.00" />
                    </UniformGrid>
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>
          </ScrollViewer>
        </TabItem>

        <TabItem x:Name="HistoryTab" Header="History">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        PanningMode="VerticalOnly">
            <Grid Margin="0,4,0,0"
                  Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="2*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0"
                      BorderBrush="{DynamicResource AppControlBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="8">
                <StackPanel>
                  <TextBlock Text="Recent sales" FontWeight="SemiBold" Margin="0,0,0,6" />
                  <ListBox x:Name="HistoryListBox"
                           Height="150"
                           FontSize="13"
                           ScrollViewer.PanningMode="VerticalOnly" />

                  <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="RefreshHistoryButton"
                            Content="Refresh history"
                            Width="140"
                            Height="34"
                            Click="OnRefreshHistoryClick" />
                    <Button x:Name="UseCurrentHistoryFiltersButton"
                            Content="Use current event"
                            Width="150"
                            Height="34"
                            Margin="6,0,0,0"
                            Click="OnUseCurrentHistoryFiltersClick" />
                    <CheckBox x:Name="IncludeShowcaseHistoryCheckBox"
                              Content="Include showcase"
                              Margin="12,8,0,0"
                              VerticalAlignment="Center"
                              Checked="OnHistoryFilterChanged"
                              Unchecked="OnHistoryFilterChanged" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Grid.Column="2"
                      BorderBrush="{DynamicResource AppControlBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="8">
                <StackPanel>
                  <TextBlock Text="Statistics filters" FontWeight="SemiBold" Margin="0,0,0,6" />

                  <TextBlock Text="Event" Margin="0,2,0,2" />
                  <TextBox x:Name="HistoryEventFilterTextBox"
                           Height="30"
                           VerticalContentAlignment="Center" />

                  <TextBlock Text="Register" Margin="0,6,0,2" />
                  <TextBox x:Name="HistoryRegisterFilterTextBox"
                           Height="30"
                           VerticalContentAlignment="Center" />

                  <TextBlock Text="User" Margin="0,6,0,2" />
                  <TextBox x:Name="HistoryUserFilterTextBox"
                           Height="30"
                           VerticalContentAlignment="Center" />

                  <UniformGrid Columns="2" Margin="0,10,0,0">
                    <TextBlock Text="Sales" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatsSalesValueText" Text="0" />
                    <TextBlock Text="Subtotal" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatsSubtotalValueText" Text="CHF 0.00" />
                    <TextBlock Text="Tips" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatsTipValueText" Text="CHF 0.00" />
                    <TextBlock Text="Total" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatsTotalValueText" Text="CHF 0.00" />
                    <TextBlock Text="Lines" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatsLinesValueText" Text="0" />
                  </UniformGrid>
                </StackPanel>
              </Border>
            </Grid>
          </ScrollViewer>
        </TabItem>
      </TabControl>
    </Border>

    <GroupBox Grid.Row="1" Grid.Column="0" Header="Products" Margin="0,0,12,0">
      <Grid Margin="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
          <CheckBox x:Name="EditModeCheckBox"
                    Content="Edit mode"
                    Margin="0,0,10,0"
                    FontSize="16"
                    VerticalAlignment="Center"
                    Checked="OnEditModeChanged"
                    Unchecked="OnEditModeChanged" />
          <Button x:Name="OpenCatalogEditorButton"
                  Content="Catalog Editor"
                  Width="140"
                  Height="42"
                  FontSize="15"
                  Visibility="Collapsed"
                  Click="OnOpenCatalogEditorClick" />
          <Button x:Name="OpenAddItemButton"
                  Content="Add Item"
                  Width="120"
                  Height="42"
                  FontSize="15"
                  Margin="8,0,0,0"
                  Visibility="Collapsed"
                  Click="OnOpenAddItemOverlayClick" />
          <Button x:Name="OpenCategoryManagerButton"
                  Content="Categories"
                  Width="120"
                  Height="42"
                  FontSize="15"
                  Margin="8,0,0,0"
                  Visibility="Collapsed"
                  Click="OnOpenCategoryManagerClick" />
        </StackPanel>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" BorderBrush="{DynamicResource AppControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="Categories" FontWeight="SemiBold" />
              <ScrollViewer Grid.Row="1"
                            Margin="0,6,0,0"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            PanningMode="VerticalOnly">
                <StackPanel x:Name="CategoryButtonsPanel" />
              </ScrollViewer>
            </Grid>
          </Border>

          <Border Grid.Column="2" BorderBrush="{DynamicResource AppControlBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <TextBlock Text="Items" FontWeight="SemiBold" />
              <ScrollViewer Grid.Row="1"
                            Margin="0,6,0,0"
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            PanningMode="VerticalOnly">
                <WrapPanel x:Name="ProductsPanel" Orientation="Horizontal" />
              </ScrollViewer>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </GroupBox>

    <GroupBox Grid.Row="1" Grid.Column="1" Header="Cart" Margin="4,0,0,0">
      <DataGrid x:Name="CartLinesGrid"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True"
                FontSize="20"
                RowHeight="56"
                ColumnHeaderHeight="52"
                AlternationCount="1000000"
                SelectionMode="Single"
                SelectionUnit="FullRow"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.PanningMode="VerticalOnly">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Item" Binding="{Binding Name}" Width="*" />
          <DataGridTemplateColumn Header="Qty" Width="190">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Grid Width="168" Height="44">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="44" />
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0"
                          Content="-"
                          Tag="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=AlternationIndex}"
                          FontSize="22"
                          FontWeight="SemiBold"
                          Padding="0"
                          ToolTip="Decrease quantity"
                          Click="OnDecreaseCartQuantityClick" />
                  <Button Grid.Column="1"
                          Content="{Binding Quantity}"
                          Tag="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=AlternationIndex}"
                          FontSize="20"
                          Margin="4,0"
                          Padding="6,2"
                          Click="OnCartQuantityClick" />
                  <Button Grid.Column="2"
                          Content="+"
                          Tag="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=AlternationIndex}"
                          FontSize="22"
                          FontWeight="SemiBold"
                          Padding="0"
                          ToolTip="Increase quantity"
                          Click="OnIncreaseCartQuantityClick" />
                </Grid>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
          <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotalDisplay}" Width="190" />
        </DataGrid.Columns>
      </DataGrid>
    </GroupBox>

    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal">
        <Button Content="Remove Selected" Width="190" Height="44" FontSize="16" Click="OnRemoveSelectedClick" />
        <Button Content="Clear" Width="120" Height="44" FontSize="16" Margin="8,0,0,0" Click="OnClearClick" />
        <Button Content="Complete Sale" Width="150" Height="44" FontSize="16" Margin="8,0,0,0" Click="OnCompleteSaleClick" />

        <Separator Margin="16,0,16,0" Width="1" />

        <Button Content="Open Customer Display" Width="220" Height="44" FontSize="16" Click="OnOpenCustomerDisplayClick" />
        <Button Content="Close Customer Display" Width="220" Height="44" FontSize="16" Margin="6,0,0,0" Click="OnCloseCustomerDisplayClick" />
      </StackPanel>

      <WrapPanel x:Name="GivenButtonsPanel" Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Center">
        <TextBlock Text="Given:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14" FontWeight="SemiBold" />

        <Button Content="0.05" Tag="5" Width="58" Height="36" Click="OnAddGivenClick" />
        <Button Content="0.10" Tag="10" Width="58" Height="36" Margin="4,0,0,0" Click="OnAddGivenClick" />
        <Button Content="0.20" Tag="20" Width="58" Height="36" Margin="4,0,0,0" Click="OnAddGivenClick" />
        <Button Content="0.50" Tag="50" Width="58" Height="36" Margin="4,0,0,0" Click="OnAddGivenClick" />
        <Button Content="1" Tag="100" Width="58" Height="36" Margin="4,0,0,0" Click="OnAddGivenClick" />
        <Button Content="2" Tag="200" Width="58" Height="36" Margin="4,0,0,0" Click="OnAddGivenClick" />
        <Button Content="5" Tag="500" Width="58" Height="36" Margin="4,0,0,0" Click="OnAddGivenClick" />
        <Button Content="10" Tag="1000" Width="58" Height="36" Margin="4,0,0,0" Click="OnAddGivenClick" />
        <Button Content="20" Tag="2000" Width="58" Height="36" Margin="4,0,0,0" Click="OnAddGivenClick" />
        <Button Content="50" Tag="5000" Width="58" Height="36" Margin="4,0,0,0" Click="OnAddGivenClick" />
        <Button Content="100" Tag="10000" Width="58" Height="36" Margin="4,0,0,0" Click="OnAddGivenClick" />
        <Button Content="200" Tag="20000" Width="58" Height="36" Margin="4,0,0,0" Click="OnAddGivenClick" />
        <Button Content="1000" Tag="100000" Width="62" Height="36" Margin="4,0,0,0" Click="OnAddGivenClick" />

        <Button Content="Given reset" Width="110" Height="36" Margin="12,0,0,0" Click="OnResetGivenClick" />

        <TextBox x:Name="CustomGivenTextBox"
                 Width="120"
                 Height="36"
                 FontSize="16"
                 Margin="12,0,0,0"
                 VerticalContentAlignment="Center"
                 ToolTip="Custom amount (e.g. 12.50)" />
        <Button Content="Add Custom"
                Width="110"
                Height="36"
                Margin="6,0,0,0"
                Click="OnAddCustomGivenClick" />
      </WrapPanel>
    </Grid>

    <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Total" FontWeight="SemiBold" FontSize="14" />
        <TextBlock x:Name="TotalValueText" FontSize="34" FontWeight="SemiBold" Text="CHF 0.00" />
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Given" FontWeight="SemiBold" FontSize="14" />
        <TextBlock x:Name="GivenValueText" FontSize="34" FontWeight="SemiBold" Text="CHF 0.00" />
      </StackPanel>
      <StackPanel Grid.Column="2">
        <TextBlock Text="Change" FontWeight="SemiBold" FontSize="14" />
        <TextBlock x:Name="ChangeValueText" FontSize="34" FontWeight="SemiBold" Text="CHF 0.00" />
        <TextBlock x:Name="BalanceHintText" FontSize="16" FontWeight="SemiBold" Text="Exact amount" />
      </StackPanel>
    </Grid>

    <TextBlock Grid.Row="4"
               Grid.Column="0"
               Grid.ColumnSpan="2"
               x:Name="StatusText"
               Margin="0,10,0,0"
               FontSize="14" />

    <Border x:Name="CatalogEditorOverlay"
            Grid.Row="0"
            Grid.Column="0"
            Grid.RowSpan="5"
            Grid.ColumnSpan="2"
            Panel.ZIndex="10"
            Background="#77000000"
            Visibility="Collapsed">
      <Border Width="640"
              MaxHeight="610"
              Padding="14"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppControlBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="120" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
              <TextBlock Text="Catalog Editor" FontSize="22" FontWeight="SemiBold" DockPanel.Dock="Left" />
              <Button Content="X"
                      Width="42"
                      Height="42"
                      FontSize="16"
                      HorizontalAlignment="Right"
                      DockPanel.Dock="Right"
                      Click="OnCloseCatalogEditorClick" />
            </DockPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="Existing items" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ListBox x:Name="EditorItemsListBox"
                     Grid.Row="2"
                     Grid.Column="0"
                     Grid.ColumnSpan="2"
                     Height="180"
                     FontSize="16"
                     ScrollViewer.PanningMode="VerticalOnly"
                     SelectionChanged="OnEditorItemSelectionChanged" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="ID:" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="EditIdText" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,8,0,0" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="EditNameTextBox" Height="36" FontSize="16" Margin="0,8,0,0" />

            <Grid Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Text="Price:" VerticalAlignment="Center" />
              <TextBox Grid.Row="0" Grid.Column="1" x:Name="EditPriceTextBox" Height="36" FontSize="16" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Category:" VerticalAlignment="Center" Margin="0,8,0,0" />
              <ComboBox Grid.Row="1"
                        Grid.Column="1"
                        x:Name="EditCategoryCombo"
                        Height="36"
                        FontSize="16"
                        Margin="0,8,0,0"
                        IsEditable="True" />

              <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,14,0,0">
                <Button Content="Save" Width="110" Height="40" FontSize="15" Click="OnSaveProductClick" />
                <Button Content="Delete Item" Width="130" Height="40" FontSize="15" Margin="8,0,0,0" Click="OnDeleteProductClick" />
                <Button Content="Close" Width="110" Height="40" FontSize="15" Margin="8,0,0,0" Click="OnCloseCatalogEditorClick" />
              </WrapPanel>
            </Grid>
          </Grid>
        </ScrollViewer>
      </Border>
    </Border>

    <Border x:Name="AddItemOverlay"
            Grid.Row="0"
            Grid.Column="0"
            Grid.RowSpan="5"
            Grid.ColumnSpan="2"
            Panel.ZIndex="30"
            Background="#77000000"
            Visibility="Collapsed">
      <Border Width="520"
              Padding="14"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppControlBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <DockPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <TextBlock Text="Add Item" FontSize="22" FontWeight="SemiBold" DockPanel.Dock="Left" />
            <Button Content="X"
                    Width="42"
                    Height="42"
                    FontSize="16"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="OnCloseAddItemOverlayClick" />
          </DockPanel>

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,8,0,0" />
          <TextBox Grid.Row="1" Grid.Column="1" x:Name="AddItemNameTextBox" Height="36" FontSize="16" Margin="0,8,0,0" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Price:" VerticalAlignment="Center" Margin="0,8,0,0" />
          <TextBox Grid.Row="2" Grid.Column="1" x:Name="AddItemPriceTextBox" Height="36" FontSize="16" Margin="0,8,0,0" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Category:" VerticalAlignment="Center" Margin="0,8,0,0" />
          <ComboBox Grid.Row="3"
                    Grid.Column="1"
                    x:Name="AddItemCategoryCombo"
                    Height="36"
                    FontSize="16"
                    Margin="0,8,0,0"
                    IsEditable="True" />

          <WrapPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,14,0,0">
            <Button Content="Create" Width="120" Height="40" FontSize="15" Click="OnCreateNewItemClick" />
            <Button Content="Cancel" Width="120" Height="40" FontSize="15" Margin="8,0,0,0" Click="OnCloseAddItemOverlayClick" />
          </WrapPanel>
        </Grid>
      </Border>
    </Border>

    <Border x:Name="CategoryManagerOverlay"
            Grid.Row="0"
            Grid.Column="0"
            Grid.RowSpan="5"
            Grid.ColumnSpan="2"
            Panel.ZIndex="20"
            Background="#77000000"
            Visibility="Collapsed">
      <Border Width="620"
              MaxHeight="620"
              Padding="14"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppControlBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Edit Mode On - Categories" FontSize="22" FontWeight="SemiBold" DockPanel.Dock="Left" />
            <Button Content="X"
                    Width="42"
                    Height="42"
                    FontSize="16"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="OnCloseCategoryManagerClick" />
          </DockPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
            <StackPanel x:Name="CategoryManagerRowsPanel" />
          </ScrollViewer>

          <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Add Category..." Width="150" Height="40" FontSize="15" Click="OnOpenAddCategoryOverlayClick" />
            <Button Content="Close" Width="120" Height="40" FontSize="15" Margin="8,0,0,0" Click="OnCloseCategoryManagerClick" />
          </WrapPanel>
        </Grid>
      </Border>
    </Border>

    <Border x:Name="AddCategoryOverlay"
            Grid.Row="0"
            Grid.Column="0"
            Grid.RowSpan="5"
            Grid.ColumnSpan="2"
            Panel.ZIndex="40"
            Background="#77000000"
            Visibility="Collapsed">
      <Border Width="460"
              Padding="14"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppControlBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Add Category" FontSize="22" FontWeight="SemiBold" DockPanel.Dock="Left" />
            <Button Content="X"
                    Width="42"
                    Height="42"
                    FontSize="16"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="OnCloseAddCategoryOverlayClick" />
          </DockPanel>

          <TextBox Grid.Row="1"
                   x:Name="AddCategoryNameTextBox"
                   Height="38"
                   FontSize="16"
                   VerticalContentAlignment="Center"
                   ToolTip="Category name" />

          <WrapPanel Grid.Row="2" Margin="0,12,0,0">
            <Button Content="Create" Width="120" Height="40" FontSize="15" Click="OnCreateCategoryClick" />
            <Button Content="Cancel" Width="120" Height="40" FontSize="15" Margin="8,0,0,0" Click="OnCloseAddCategoryOverlayClick" />
          </WrapPanel>
        </Grid>
      </Border>
    </Border>

    <Border x:Name="CartQuantityOverlay"
            Grid.Row="0"
            Grid.Column="0"
            Grid.RowSpan="5"
            Grid.ColumnSpan="2"
            Panel.ZIndex="45"
            Background="#77000000"
            Visibility="Collapsed">
      <Border Width="480"
              Padding="14"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppControlBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="Set Quantity"
                       FontSize="22"
                       FontWeight="SemiBold"
                       DockPanel.Dock="Left" />
            <Button Content="X"
                    Width="42"
                    Height="42"
                    FontSize="16"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="OnCloseCartQuantityOverlayClick" />
          </DockPanel>

          <TextBlock x:Name="CartQuantityItemText"
                     Grid.Row="1"
                     FontSize="16"
                     Margin="0,0,0,8"
                     Text="Item" />

          <TextBox x:Name="CartQuantityTextBox"
                   Grid.Row="2"
                   Height="44"
                   FontSize="20"
                   VerticalContentAlignment="Center"
                   ToolTip="Enter quantity (e.g. 45)" />

          <WrapPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="Apply" Width="120" Height="42" FontSize="16" Click="OnApplyCartQuantityClick" />
            <Button Content="Cancel" Width="120" Height="42" FontSize="16" Margin="8,0,0,0" Click="OnCloseCartQuantityOverlayClick" />
          </WrapPanel>
        </Grid>
      </Border>
    </Border>

    <Border x:Name="OnboardingOverlay"
            Grid.Row="0"
            Grid.Column="0"
            Grid.RowSpan="5"
            Grid.ColumnSpan="2"
            Panel.ZIndex="80"
            Background="#AA000000"
            Visibility="Collapsed">
      <Border Width="760"
              MaxHeight="620"
              Padding="18"
              Background="{DynamicResource AppSurfaceBrush}"
              BorderBrush="{DynamicResource AppControlBorderBrush}"
              BorderThickness="1"
              CornerRadius="8"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <ScrollViewer VerticalScrollBarVisibility="Auto" PanningMode="VerticalOnly">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,12">
              <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="CashSloth quick start"
                           FontSize="26"
                           FontWeight="SemiBold" />
                <TextBlock Text="Set up the register, sell from the Shop tab, and use Event mode when several tills work together."
                           Margin="0,4,0,0"
                           TextWrapping="Wrap"
                           Opacity="0.85" />
              </StackPanel>
              <Button Content="X"
                      Width="42"
                      Height="42"
                      FontSize="16"
                      HorizontalAlignment="Right"
                      DockPanel.Dock="Right"
                      Click="OnCloseOnboardingClick" />
            </DockPanel>

            <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,12">
              <Border BorderBrush="{DynamicResource AppControlBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="10"
                      Margin="0,0,6,6">
                <StackPanel>
                  <TextBlock Text="1. Shop"
                             FontSize="18"
                             FontWeight="SemiBold"
                             Margin="0,0,0,4" />
                  <TextBlock Text="Use product buttons to add items. Change quantities directly in the cart with - and +, or tap the quantity number for exact input."
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border BorderBrush="{DynamicResource AppControlBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="10"
                      Margin="6,0,0,6">
                <StackPanel>
                  <TextBlock Text="2. Checkout"
                             FontSize="18"
                             FontWeight="SemiBold"
                             Margin="0,0,0,4" />
                  <TextBlock Text="Use quick tender buttons or a custom amount, then complete the sale. Tips and payment method are set in Event."
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border BorderBrush="{DynamicResource AppControlBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="10"
                      Margin="0,6,6,0">
                <StackPanel>
                  <TextBlock Text="3. Event mode"
                             FontSize="18"
                             FontWeight="SemiBold"
                             Margin="0,0,0,4" />
                  <TextBlock Text="Name the event and register. Hosts can scan for client registers; clients can make themselves visible on the network."
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border BorderBrush="{DynamicResource AppControlBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="4"
                      Padding="10"
                      Margin="6,6,0,0">
                <StackPanel>
                  <TextBlock Text="4. Accounts and presets"
                             FontSize="18"
                             FontWeight="SemiBold"
                             Margin="0,0,0,4" />
                  <TextBlock Text="Anyone can create a normal account. Admins manage roles and presets. The tutorial can be opened again from Settings."
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </UniformGrid>

            <TextBlock Grid.Row="2"
                       Text="Changing language, currency, or theme affects fixed app UI only. Product names, categories, usernames, and passwords stay as entered."
                       TextWrapping="Wrap"
                       Opacity="0.85"
                       Margin="0,0,0,12" />

            <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
              <Button Content="Start using CashSloth"
                      Width="190"
                      Height="40"
                      FontSize="15"
                      Click="OnCloseOnboardingClick" />
            </WrapPanel>
          </Grid>
        </ScrollViewer>
      </Border>
    </Border>

    <Border x:Name="StartupOverlay"
            Grid.Row="0"
            Grid.Column="0"
            Grid.RowSpan="5"
            Grid.ColumnSpan="2"
            Panel.ZIndex="100"
            Background="{DynamicResource AppWindowBackgroundBrush}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center">
        <Image Source="Assets/CashSlothLogo.png"
               Width="190"
               Height="190"
               Stretch="Uniform"
               Margin="0,0,0,18" />
        <TextBlock Text="CashSloth"
                   FontSize="44"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center" />
        <TextBlock Text="Point of Sale"
                   FontSize="16"
                   HorizontalAlignment="Center"
                   Margin="0,6,0,18"
                   Opacity="0.8" />
        <ProgressBar Width="260"
                     Height="8"
                     IsIndeterminate="True" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
