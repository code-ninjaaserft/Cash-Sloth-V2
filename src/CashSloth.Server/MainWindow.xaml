<Window x:Class="CashSloth.Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CashSloth Server" Width="1180" Height="780" MinWidth="980" MinHeight="680"
        Background="{StaticResource WindowBackground}"
        Loaded="OnLoaded" Closing="OnClosing" StateChanged="OnWindowStateChanged">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="OverallIndicator" Width="18" Height="18" Fill="#FF777777" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="CashSloth Zentralserver" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock x:Name="OverallStatusText" Text="Gestoppt" Foreground="#FF555555" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StartButton" Content="Start" Click="OnStart" Background="#FFDCFCE7" />
                    <Button x:Name="StopButton" Content="Stop" Click="OnStop" IsEnabled="False" Background="#FFFEE2E2" />
                    <Button Content="Status prüfen" Click="OnCheckStatus" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <UniformGrid Columns="5" Margin="0,0,0,12">
                            <Border Background="White" CornerRadius="8" Padding="12" Margin="4"><StackPanel><Ellipse x:Name="LocalIndicator" Width="14" Height="14" Fill="#FF777777"/><TextBlock Text="Lokaler HTTP-Server" HorizontalAlignment="Center" Margin="0,5,0,0"/><TextBlock x:Name="LocalStatusText" Text="Aus" HorizontalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Border>
                            <Border Background="White" CornerRadius="8" Padding="12" Margin="4"><StackPanel><Ellipse x:Name="TunnelIndicator" Width="14" Height="14" Fill="#FF777777"/><TextBlock Text="Cloudflare-Tunnel" HorizontalAlignment="Center" Margin="0,5,0,0"/><TextBlock x:Name="TunnelStatusText" Text="Aus" HorizontalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Border>
                            <Border Background="White" CornerRadius="8" Padding="12" Margin="4"><StackPanel><Ellipse x:Name="PublicIndicator" Width="14" Height="14" Fill="#FF777777"/><TextBlock Text="Öffentlich erreichbar" HorizontalAlignment="Center" Margin="0,5,0,0"/><TextBlock x:Name="PublicStatusText" Text="Nein" HorizontalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Border>
                            <Border Background="White" CornerRadius="8" Padding="12" Margin="4"><StackPanel><Ellipse x:Name="DatabaseIndicator" Width="14" Height="14" Fill="#FF777777"/><TextBlock Text="Datenbank" HorizontalAlignment="Center" Margin="0,5,0,0"/><TextBlock x:Name="DatabaseStatusText" Text="Nicht geprüft" HorizontalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Border>
                            <Border Background="White" CornerRadius="8" Padding="12" Margin="4"><StackPanel><Ellipse x:Name="WakeIndicator" Width="14" Height="14" Fill="#FF777777"/><TextBlock Text="Wake-Guard" HorizontalAlignment="Center" Margin="0,5,0,0"/><TextBlock x:Name="WakeStatusText" Text="Aus" HorizontalAlignment="Center" FontWeight="SemiBold"/></StackPanel></Border>
                        </UniformGrid>

                        <GroupBox Header="Serverinformationen" Margin="4">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Öffentliche URL" Margin="4"/><TextBlock Grid.Row="0" Grid.Column="1" x:Name="PublicUrlText" Margin="4" TextWrapping="Wrap"/><StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal"><Button Content="Öffnen" Click="OnOpenPublicUrl"/><Button Content="Kopieren" Click="OnCopyPublicUrl"/></StackPanel>
                                <TextBlock Grid.Row="1" Text="Serverversion" Margin="4"/><TextBlock Grid.Row="1" Grid.Column="1" x:Name="VersionText" Margin="4"/>
                                <TextBlock Grid.Row="2" Text="Datenbankgrösse" Margin="4"/><TextBlock Grid.Row="2" Grid.Column="1" x:Name="DatabaseSizeText" Margin="4"/>
                                <TextBlock Grid.Row="3" Text="Letzter Wechselkursabruf" Margin="4"/><TextBlock Grid.Row="3" Grid.Column="1" x:Name="LastFxText" Margin="4"/>
                                <TextBlock Grid.Row="4" Text="Letzte Sicherung" Margin="4"/><TextBlock Grid.Row="4" Grid.Column="1" x:Name="LastBackupText" Margin="4"/>
                                <TextBlock Grid.Row="5" Text="Laufende Events" Margin="4"/><TextBlock Grid.Row="5" Grid.Column="1" x:Name="RunningEventsText" Margin="4"/>
                                <TextBlock Grid.Row="6" Text="Letzter Fehler" Margin="4"/><TextBlock Grid.Row="6" Grid.Column="1" x:Name="LastErrorText" Margin="4" Foreground="#FFB42318" TextWrapping="Wrap"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox x:Name="FirstSetupGroup" Header="Ersteinrichtung – erster Administrator" Margin="4,12,4,4">
                            <StackPanel Margin="10">
                                <TextBlock Text="Es gibt absichtlich kein admin/admin. Erstelle jetzt den ersten lokalen Administrator." TextWrapping="Wrap" Margin="3"/>
                                <TextBlock Text="Benutzername" FontWeight="SemiBold" Margin="3,10,3,2"/>
                                <TextBox x:Name="FirstAdminNameBox" Width="320" HorizontalAlignment="Left" ToolTip="3 bis 50 Zeichen; Buchstaben, Zahlen, Punkt, Bindestrich und Unterstrich"/>
                                <TextBlock Text="Passwort" FontWeight="SemiBold" Margin="3,10,3,2"/>
                                <PasswordBox x:Name="FirstAdminPasswordBox" Width="320" HorizontalAlignment="Left" ToolTip="Mindestens 12 Zeichen"/>
                                <TextBlock Text="Mindestens 12 Zeichen sowie je ein Grossbuchstabe, Kleinbuchstabe, eine Zahl und ein Sonderzeichen." Foreground="#FF555555" TextWrapping="Wrap" Margin="3,4,3,6"/>
                                <Button Content="Administrator erstellen" Click="OnCreateFirstAdmin" HorizontalAlignment="Left" Padding="16,7"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Accounts">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DataGrid x:Name="AccountsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Benutzername" Binding="{Binding Username}" Width="*"/>
                            <DataGridTextColumn Header="Rolle" Binding="{Binding Role}" Width="110"/>
                            <DataGridCheckBoxColumn Header="Freigegeben" Binding="{Binding IsApproved}" Width="110"/>
                            <DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="80"/>
                            <DataGridCheckBoxColumn Header="Passwortwechsel" Binding="{Binding MustChangePassword}" Width="125"/>
                            <DataGridTextColumn Header="Erstellt" Binding="{Binding CreatedAtUtc}" Width="170"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="1" Margin="0,8,0,0">
                        <Button Content="Aktualisieren" Click="OnRefreshAdministration"/>
                        <Button Content="Freigabe umschalten" Click="OnToggleApproval"/>
                        <ComboBox x:Name="RoleComboBox" Width="130" Margin="4" SelectedIndex="0"><ComboBoxItem Content="User"/><ComboBoxItem Content="Creator"/><ComboBoxItem Content="Admin"/></ComboBox>
                        <Button Content="Rolle setzen" Click="OnSetRole"/>
                        <Button Content="Aktiv/Sperren" Click="OnToggleAccount"/>
                        <Button Content="Passwort zurücksetzen" Click="OnResetPassword"/>
                    </WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Geräte">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="#FFEFF6FF" CornerRadius="8" Padding="12" Margin="0,0,0,10"><StackPanel Orientation="Horizontal"><Button Content="Neuen Pairingcode erzeugen" Click="OnCreatePairingCode"/><TextBlock x:Name="PairingCodeText" FontFamily="Consolas" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0"/><TextBlock x:Name="PairingExpiryText" VerticalAlignment="Center"/></StackPanel></Border>
                    <DataGrid Grid.Row="1" x:Name="DevicesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                        <DataGrid.Columns><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridCheckBoxColumn Header="Aktiv" Binding="{Binding IsActive}" Width="80"/><DataGridTextColumn Header="Letzter Kontakt" Binding="{Binding LastSeenAtUtc}" Width="180"/><DataGridTextColumn Header="Fingerprint" Binding="{Binding PublicKeyFingerprint}" Width="300"/></DataGrid.Columns>
                    </DataGrid>
                    <WrapPanel Grid.Row="2" Margin="0,8,0,0"><Button Content="Aktualisieren" Click="OnRefreshAdministration"/><Button Content="Gerät aktiv/sperren" Click="OnToggleDevice"/></WrapPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Backups">
                <StackPanel Margin="18">
                    <TextBlock Text="Lokale SQLite-Snapshots werden vor Migrationen, beim Start, täglich und nach sauberem Stop erstellt. Die letzten zehn bleiben erhalten." TextWrapping="Wrap" Margin="4,0,4,12"/>
                    <WrapPanel><Button Content="Lokales Backup jetzt" Click="OnLocalBackup"/><Button Content="Verschlüsseltes Umzugsbackup…" Click="OnPortableBackup"/><Button Content="Backup wiederherstellen…" Click="OnRestoreBackup"/></WrapPanel>
                    <TextBlock x:Name="BackupReminderText" Margin="4,16,4,4" FontWeight="SemiBold"/>
                    <TextBlock Text="Ein Umzugsbackup enthält Datenbank, Serverschlüssel, Data-Protection-Keys, Konfiguration und Tunnel-Token. Bewahre die Passphrase separat auf." TextWrapping="Wrap" Margin="4" Foreground="#FF555555"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Einstellungen">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Öffentliche HTTPS-URL" VerticalAlignment="Center"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="PublicUrlBox"/>
                        <TextBlock Grid.Row="1" Text="Cloudflare-Tunnel-Token" VerticalAlignment="Center"/><PasswordBox Grid.Row="1" Grid.Column="1" x:Name="TunnelTokenBox" ToolTip="Leer lassen, um das gespeicherte Token beizubehalten"/>
                        <TextBlock Grid.Row="2" Text="cloudflared.exe" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="CloudflaredPathBox"/><Button Grid.Row="2" Grid.Column="2" Content="Durchsuchen" Click="OnBrowseCloudflared"/>
                        <TextBlock Grid.Row="3" Text="Datenpfad" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="DataPathBox"/>
                        <TextBlock Grid.Row="4" Text="Update-Manifest (HTTPS)" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" x:Name="UpdateManifestBox"/>
                        <CheckBox Grid.Row="5" Grid.Column="1" x:Name="AutoStartCheckBox" Content="Mit Windows starten (standardmässig aus)" Margin="4,10"/>
                        <WrapPanel Grid.Row="6" Grid.Column="1" Margin="0,12,0,0"><Button Content="Einstellungen speichern" Click="OnSaveSettings"/><Button Content="Trust-Datei exportieren…" Click="OnExportTrust"/></WrapPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Audit &amp; Logs">
                <Grid Margin="14">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True">
                        <DataGrid.Columns><DataGridTextColumn Header="Zeit" Binding="{Binding CreatedAtUtc}" Width="170"/><DataGridTextColumn Header="Akteur" Binding="{Binding Actor}" Width="150"/><DataGridTextColumn Header="Aktion" Binding="{Binding Action}" Width="180"/><DataGridTextColumn Header="Ziel" Binding="{Binding TargetId}" Width="160"/><DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns>
                    </DataGrid>
                    <TextBox Grid.Row="1" x:Name="RuntimeLogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
